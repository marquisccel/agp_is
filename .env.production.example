# ══════════════════════════════════════════════════════════════════════
#  AGP IS -- Variabel Lingkungan PRODUKSI
# ══════════════════════════════════════════════════════════════════════
#
# Berkas ini BUKAN untuk disalin jadi .env di laptop. Untuk ngoding,
# pakai .env.example. Berkas ini adalah daftar isian yang harus dimasukkan
# satu per satu di dasbor penyedia hosting (Vercel: Settings -> Environment
# Variables), karena di produksi nilai-nilai ini tidak boleh ada di dalam
# repositori sama sekali.
#
# Langkah lengkapnya ada di docs/deploy-vercel.md.
#
# JANGAN pernah meng-commit berkas .env yang sudah terisi nilai asli.


# ── 1. Basis Data ─────────────────────────────────────────────────────
#
# WAJIB memakai connection string versi POOLED, bukan yang langsung.
#
# Alasannya: di Vercel setiap permintaan berjalan sebagai fungsi terpisah,
# dan tiap fungsi membuka koneksi Prisma sendiri. Tanpa pooler, koneksi
# menumpuk sampai Postgres menolak dengan "too many connections". Gejalanya
# menipu: aplikasi terasa normal saat dicoba sendiri, lalu mulai gagal
# justru ketika beberapa orang memakai bersamaan -- persis saat tim AGP
# menguji.
#
# Supabase : porta 6543, tambahkan ?pgbouncer=true&connection_limit=1
# Neon     : pakai host yang mengandung "-pooler"
#
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Dipakai HANYA oleh perintah migrasi Prisma, tidak oleh aplikasi yang
# sedang berjalan. Pooler mode transaksi tidak bisa menjalankan migrasi
# karena migrasi butuh sesi yang bertahan lintas perintah.
#
# Di Supabase, buka tombol Connect di bar atas, tab ORM, pilih Prisma.
# Kedua nilai ini diberikan langsung dan tinggal disalin; yang perlu kamu
# ganti cuma [YOUR-PASSWORD] dengan password basis data yang kamu simpan
# saat membuat proyek.
#
# Keduanya WAJIB diisi di Vercel. Meski migrasi dijalankan dari laptop,
# `prisma generate` saat build ikut membaca schema.prisma, dan schema itu
# menyebut DIRECT_URL -- kalau kosong, build-nya gagal.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"


# ── 2. NextAuth ───────────────────────────────────────────────────────
#
# Harus URL produksi yang sebenarnya, lengkap dengan https:// dan tanpa
# garis miring di akhir. Kalau salah, login berhasil tapi pengalihan
# setelahnya gagal dan pengguna terlempar balik ke halaman masuk.
#
# Catatan soal preview deployment: setiap push membuat URL preview baru
# yang berbeda, dan login SELALU gagal di sana karena tidak cocok dengan
# nilai ini. Itu bukan kerusakan. Bagikan ke tim AGP hanya URL produksi.
NEXTAUTH_URL="https://GANTI-DENGAN-DOMAIN-PRODUKSI"

# Rahasia penanda tangan sesi. WAJIB dibuat baru untuk produksi, jangan
# menyalin nilai dari laptop. Siapa pun yang memegang nilai ini bisa
# memalsukan sesi siapa saja, termasuk MANAGER.
#
# Nilainya harus benar-benar acak. "kunci-rahasia-agp-2026" atau kalimat
# apa pun yang bisa dibaca manusia TIDAK memenuhi syarat: yang bisa ditebak
# bisa dipakai memalsukan sesi, dan pemalsuan itu tidak meninggalkan jejak
# login gagal sama sekali.
#
# Buat dengan (jalan di Windows, macOS, dan Linux, tanpa perlu openssl):
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Jangan pakai nilai yang sama dengan yang di laptop, dan jangan pernah
# menempelkannya ke chat, tiket, atau grup.
NEXTAUTH_SECRET="GANTI-DENGAN-HASIL-PERINTAH-DI-ATAS"


# ── 3. Object Storage (WAJIB di produksi) ─────────────────────────────
#
# Tempat bukti transfer dan nota pelunasan disimpan.
#
# Kalau keempat nilai di bawah dikosongkan, aplikasi jatuh ke penyimpanan
# lokal (./storage/uploads). Di laptop itu tidak apa-apa. Di Vercel itu
# BENCANA: sistem berkasnya sementara, jadi setiap deploy baru menghapus
# seluruh bukti transfer yang sudah diunggah. Padahal itu bukti keuangan
# yang dipakai saat audit.
#
# Periksa setelah deploy: unggah satu bukti transfer, lakukan deploy ulang,
# lalu buka lagi bukti itu. Kalau masih tampil, konfigurasinya benar.
#
# Supabase Storage : https://<ref-proyek>.supabase.co/storage/v1/s3
# Cloudflare R2    : https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"

# Bucket-nya harus PRIVAT. Aplikasi tidak pernah memberikan URL bucket ke
# peramban; berkas selalu dilayani lewat /api/files yang memeriksa sesi
# lebih dulu. Kalau bucket dibuat publik, siapa pun yang menebak nama
# berkasnya bisa membuka struk transfer bank tanpa perlu masuk.


# ── 4. Notifikasi error (opsional, sangat disarankan) ─────────────────
#
# Selama dua minggu uji coba, ini yang membedakan "tim mengeluh tiga hari
# kemudian" dengan "kamu tahu satu menit setelah kejadian". Isi dengan URL
# webhook Discord, Telegram, atau Slack. Kiriman dibatasi satu per menit.
ALERT_WEBHOOK_URL=""


# ── Tidak dipakai di Vercel ───────────────────────────────────────────
#
# POSTGRES_USER, POSTGRES_PASSWORD, dan POSTGRES_DB hanya dibaca oleh
# docker-compose saat menjalankan Postgres sendiri. Di Vercel basis
# datanya dikelola penyedia lain, jadi ketiganya tidak perlu diisi.
# Ketiganya tetap dibutuhkan kalau nanti pindah ke VPS.
