# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep the example committed)
.env*
!.env.example
!.env.production.example

# local databases and generated runtime assets
*.db
*.db-journal
/public/uploads/

# berkas bukti saat Object Storage belum dikonfigurasi (dev)
/storage/

# hasil dump database
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Konfigurasi lokal perkakas, bukan bagian proyek
.claude/
