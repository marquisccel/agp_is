# ── Database ────────────────────────────────────────────────────────────
# Di produksi WAJIB pakai password kuat, bukan "postgres". Nilai ini juga
# dibaca docker-compose untuk membuat user Postgres-nya.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="ganti-dengan-password-kuat"
POSTGRES_DB="agp_is"
DATABASE_URL="postgresql://postgres:ganti-dengan-password-kuat@localhost:5432/agp_is?schema=public"
# Dipakai HANYA oleh perintah migrasi Prisma. Di laptop, Postgres tidak
# lewat pooler, jadi nilainya sama persis dengan DATABASE_URL.
DIRECT_URL="postgresql://postgres:ganti-dengan-password-kuat@localhost:5432/agp_is?schema=public"

# ── NextAuth ────────────────────────────────────────────────────────────
# NEXTAUTH_URL harus URL publik yang sebenarnya (https://domain-anda),
# bukan localhost -- kalau salah, login akan gagal redirect di produksi.
NEXTAUTH_URL="http://localhost:3000"
# Buat dengan: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# ── Object Storage (S3-compatible) ──────────────────────────────────────
# Tempat menyimpan bukti transfer dan nota pelunasan.
# Kalau keempat nilai di bawah dikosongkan, aplikasi otomatis menyimpan ke
# folder lokal ./storage/uploads -- itu HANYA untuk ngoding di laptop.
# Di produksi keempatnya wajib diisi, kalau tidak berkasnya ikut hilang
# setiap container di-redeploy.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"

# ── Notifikasi error (opsional tapi sangat disarankan) ──────────────────
# Tanpa ini, error di produksi hanya mendarat di log dan baru ketahuan
# kalau ada yang mengeluh. Isi dengan URL webhook Discord / Telegram /
# Slack; kiriman dibatasi maksimal satu per menit agar tidak membanjiri.
ALERT_WEBHOOK_URL=""
